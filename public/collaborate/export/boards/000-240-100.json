        },
        "note": {
          "backgroundColor": {
            "r": 222,
            "g": 243,
            "b": 80
          }
        }
      }
    },
    {
      "name": "Edit/Modify Cart",
      "description": "As a shopper, I want to be able to edit/modify the selected items and quantities in my cart, so that I can purchase the correct item(s).\n\nAC: The shopper should be able to click on the \"view cart\" button/image.\nThen the shopper should be able to change the the quantity of each item selected by clicking on a \"+\" or \"-\" sign (cross-reference with the total quantity available).\nThen the shopper should be able to remove items from the card by clicking on the \"delete\" button or \"trash can\" icon.",
      "itemType": {
        "id": "T1621623567657NAE5JLQ3W0PDW3V",
        "name": "Story",
        "description": "Use this item to create your refined Story.",
        "icon": {
