    {
      "name": "Access Cart",
      "description": "As a shopper, I want to be able to access my shopping cart from any page, so that I can manage my cart/items at any time.\n\nAC: Given the shopper is on the website,\nWhen they are browsing on any page,\nThen the shopping cart icon is visible on the upper right-hand corner",
      "itemType": {
        "id": "T1621623567657NAE5JLQ3W0PDW3V",
        "name": "Story",
        "description": "Use this item to create your refined Story.",
        "icon": {
