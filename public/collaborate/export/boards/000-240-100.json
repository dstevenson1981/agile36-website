            "b": 80
          }
        }
      }
    },
    {
      "name": "Add to Cart",
      "description": "As a shopper, I want to be able to add selected items and quantities to my cart, so that I can purchase them.\n\nAC: The shopper should be able to click on the \"add to cart\" button.\nThen that selected item with the price, image, title and quantity are displayed in the shopping cart.",
      "itemType": {
        "id": "T1621623567657NAE5JLQ3W0PDW3V",
        "name": "Story",
        "description": "Use this item to create your refined Story.",
        "icon": {
