        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"REPLACE_APOLLO_API_KEY\",\n  \"email\": \"{{ $('Set Record & Fields').item.json.email }}\"\n}",
        "options": {}
