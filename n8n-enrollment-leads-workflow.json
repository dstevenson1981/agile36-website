        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"api_key\": \"REPLACE_APOLLO_API_KEY\",\n  \"q_organization_name\": \"{{ $json.person?.organization?.name ?? $json.organization?.name ?? '' }}\",\n  \"person_titles\": [\"{{ $json.person?.title ?? $json.title ?? '' }}\"],\n  \"page\": 1,\n  \"per_page\": 10\n}",
        "options": {}
      },
      "id": "apollo-search-1",
      "name": "Apollo – Search 10 Lookalikes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 420],
      "onError": "continueRegularOutput",
      "notesInFlow": true,
      "notes": "Same company + same role, max 10. Adjust person_titles if Apollo format differs."
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "tableId": "expansion_opportunities",
        "dataMode": "autoMapInputData",
        "columnMapping": "={\n  \"email\": \"{{ $json.email }}\",\n  \"first_name\": \"{{ $json.first_name }}\",\n  \"last_name\": \"{{ $json.last_name }}\",\n  \"job_title\": \"{{ $json.title || $json.job_title }}\",\n  \"company_name\": \"{{ $('Apollo – Enrich Person').item.json.person?.organization?.name || $('Apollo – Enrich Person').item.json.organization?.name }}\",\n  \"company_size\": \"{{ $json.organization?.estimated_num_employees || $json.estimated_num_employees }}\",\n  \"seniority\": \"{{ $json.seniority }}\",\n  \"linkedin_url\": \"{{ $json.linkedin_url }}\",\n  \"source\": \"enrollment_lookalike\",\n  \"source_email\": \"{{ $('Set Record & Fields').item.json.email }}\"\n}",
        "options": {}
      },
      "id": "supabase-1",
      "name": "Supabase – Insert Lookalikes",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1340, 420],
      "credentials": { "supabaseApi": { "id": "REPLACE_SUPABASE_CREDENTIAL_ID", "name": "Supabase account" } },
      "notesInFlow": true,
      "notes": "Loop over Apollo people array; filter out source email; insert into expansion_opportunities."
    },
    {
      "parameters": {
        "jsCode": "const setNode = $('Set Record & Fields').first().json;\nconst enrich = $('Apollo – Enrich Person').first().json;\nconst people = $input.all();\nconst company = enrich?.person?.organization?.name || enrich?.organization?.name || '';\nconst sourceEmail = (setNode.email || '').toLowerCase();\nconst title = enrich?.person?.title || enrich?.person?.job_title || enrich?.title || '';\n\nconst rows = people\n  .map(p => p.json)\n  .filter(p => (p.email || '').toLowerCase() !== sourceEmail)\n  .slice(0, 10)\n  .map(p => ({\n    json: {\n      email: (p.email || '').toLowerCase(),\n      first_name: p.first_name || p.name?.split(' ')[0] || null,\n      last_name: p.last_name || p.name?.split(' ').slice(1).join(' ') || null,\n      title: p.title || p.job_title,\n      job_title: p.title || p.job_title,\n      organization: p.organization,\n      seniority: p.seniority,\n      linkedin_url: p.linkedin_url,\n      company_name: company,\n      source_email: sourceEmail\n    }\n  }));\n\nreturn rows;"
      },
      "id": "code-1",
      "name": "Map Lookalikes for Supabase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 540]
    }
