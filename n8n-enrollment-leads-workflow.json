            },
            {
              "name": "from",
              "value": "={\"email\":\"REPLACE_WITH_FROM_EMAIL\",\"name\":\"Agile36\"}"
            },
            {
              "name": "content",
              "value": "=[{\"type\":\"text/plain\",\"value\":\"Hi {{ $json.first_name || 'there' }},\\n\\nYou started checking out but did not complete your order. Complete your purchase with $150 off when you use promo code 150off at checkout.\\n\\nVisit: https://www.agile36.com/courses\\n\\nThank you,\\nAgile36 Team\"}]"
            }
